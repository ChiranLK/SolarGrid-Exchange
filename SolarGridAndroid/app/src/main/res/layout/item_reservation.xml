<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/sg_space_12">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/sg_space_20">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reservation_item_station"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SolarGrid.Section" />

            <TextView
                android:id="@+id/reservation_item_status"
                style="@style/Widget.SolarGrid.StatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_12" />
        </LinearLayout>

        <TextView
            android:id="@+id/reservation_item_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall"
            app:drawableStartCompat="@drawable/sg_ic_calendar_small" />

        <View
            style="@style/Widget.SolarGrid.Divider"
            android:layout_marginTop="@dimen/sg_space_16" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reservation_item_reference"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall"
                android:textSize="13sp"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/reservation_item_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_12"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title"
                android:textSize="26sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
