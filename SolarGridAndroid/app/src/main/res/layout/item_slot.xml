<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/sg_touch_min"
        android:orientation="horizontal"
        android:padding="@dimen/sg_space_20">

        <ImageView
            style="@style/Widget.SolarGrid.IconTile"
            android:contentDescription="@null"
            android:src="@drawable/sg_ic_clock" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sg_space_16"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/slot_item_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <TextView
                android:id="@+id/slot_item_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_4"
                android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />

            <TextView
                android:id="@+id/slot_item_capacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/sg_space_8"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/sg_ic_chevron"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
