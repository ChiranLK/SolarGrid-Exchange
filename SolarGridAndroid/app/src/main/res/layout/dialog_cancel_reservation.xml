<?xml version="1.0" encoding="utf-8"?>
<!-- Body of the existing MaterialAlertDialog; its title and buttons stay owned by the dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sg_space_24"
    android:paddingTop="@dimen/sg_space_8"
    android:paddingEnd="@dimen/sg_space_24">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sg_bg_tonal_card"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_space_16"
        android:paddingTop="@dimen/sg_space_4"
        android:paddingEnd="@dimen/sg_space_16"
        android:paddingBottom="@dimen/sg_space_4">

        <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
            <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/reservation_reference" />
            <TextView
                android:id="@+id/cancel_dialog_reference"
                style="@style/Widget.SolarGrid.ReceiptValue"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
            <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/station_label" />
            <TextView android:id="@+id/cancel_dialog_station" style="@style/Widget.SolarGrid.ReceiptValue" />
        </LinearLayout>

        <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
            <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/scheduled_time" />
            <TextView android:id="@+id/cancel_dialog_time" style="@style/Widget.SolarGrid.ReceiptValue" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_16"
        android:labelFor="@id/cancel_dialog_reason"
        android:text="@string/cancellation_reason_hint"
        android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

    <EditText
        android:id="@+id/cancel_dialog_reason"
        style="@style/Widget.SolarGrid.EditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_8"
        android:gravity="top|start"
        android:hint="@string/cancellation_reason_hint"
        android:importantForAutofill="no"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLines="4"
        android:minLines="2" />
</LinearLayout>
