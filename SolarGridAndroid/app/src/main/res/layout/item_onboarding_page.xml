<?xml version="1.0" encoding="utf-8"?>
<!-- One onboarding page. Views are animated in by OnboardingActivity when the page becomes current. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingEnd="@dimen/sg_gutter">

        <!-- Illustration -->
        <FrameLayout
            android:id="@+id/onboarding_art"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:clipChildren="false"
            android:importantForAccessibility="noHideDescendants">

            <ImageView
                android:id="@+id/onboarding_ring"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/sg_onboarding_ring" />

            <FrameLayout
                android:id="@+id/onboarding_tile"
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center"
                android:background="@drawable/sg_bg_onboarding_tile">

                <ImageView
                    android:id="@+id/onboarding_icon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    app:tint="@color/sg_hero" />
            </FrameLayout>

            <TextView
                android:id="@+id/onboarding_chip_one"
                style="@style/Widget.SolarGrid.OnboardingChip"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="36dp" />

            <TextView
                android:id="@+id/onboarding_chip_two"
                style="@style/Widget.SolarGrid.OnboardingChip"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="36dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/onboarding_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

        <TextView
            android:id="@+id/onboarding_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:accessibilityHeading="true"
            android:textAppearance="@style/TextAppearance.SolarGrid.Display"
            android:textColor="@color/sg_on_hero" />

        <TextView
            android:id="@+id/onboarding_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:textAppearance="@style/TextAppearance.SolarGrid.HeroBody" />

        <TextView
            android:id="@+id/onboarding_point_one"
            style="@style/Widget.SolarGrid.OnboardingPoint"
            android:layout_marginTop="@dimen/sg_space_24" />

        <TextView
            android:id="@+id/onboarding_point_two"
            style="@style/Widget.SolarGrid.OnboardingPoint"
            android:layout_marginTop="@dimen/sg_space_12" />
    </LinearLayout>
</ScrollView>
