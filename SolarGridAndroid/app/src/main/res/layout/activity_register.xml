<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    tools:ignore="Overdraw,UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_16"
        android:paddingEnd="@dimen/sg_gutter"
        android:paddingBottom="@dimen/sg_space_32">

        <!-- Top bar: back returns to sign-in (same as the existing Back to sign in action). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/register_toolbar_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back_to_sign_in"
                android:src="@drawable/sg_ic_back"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_16"
                android:text="@string/sg_register_toolbar"
                android:textAppearance="@style/TextAppearance.SolarGrid.ToolbarTitle"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityHeading="true"
            android:text="@string/sg_register_hero"
            android:textAppearance="@style/TextAppearance.SolarGrid.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:text="@string/sg_register_intro"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

        <TextView
            android:id="@+id/register_error"
            style="@style/Widget.SolarGrid.Banner.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityLiveRegion="assertive"
            android:visibility="gone" />

        <!-- 01 / Identity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_32"
            android:accessibilityHeading="true"
            android:text="@string/sg_register_identity"
            android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:labelFor="@id/register_nic"
            android:text="@string/nic"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_nic_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:counterEnabled="true"
            app:counterMaxLength="12"
            app:helperText="@string/nic_hint"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_nic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789VvXx"
                android:hint="@string/nic"
                android:importantForAutofill="no"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="12" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:labelFor="@id/register_full_name"
            android:text="@string/full_name"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_full_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_user">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_full_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="@string/full_name"
                android:imeOptions="actionNext"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 02 / Contact -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_32"
            android:accessibilityHeading="true"
            android:text="@string/sg_register_contact"
            android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:labelFor="@id/register_email"
            android:text="@string/email_address"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_email_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/sg_email_placeholder"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:maxLength="100" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:labelFor="@id/register_phone"
            android:text="@string/phone"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_phone_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phone"
                android:hint="@string/phone"
                android:imeOptions="actionNext"
                android:inputType="phone"
                android:maxLength="20" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:labelFor="@id/register_address"
            android:text="@string/address_optional"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_address_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_pin">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="postalAddress"
                android:hint="@string/address_optional"
                android:inputType="textPostalAddress|textMultiLine"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- 03 / Security -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_32"
            android:accessibilityHeading="true"
            android:text="@string/sg_register_security"
            android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:labelFor="@id/register_password"
            android:text="@string/password"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:endIconMode="password_toggle"
            app:helperText="@string/password_rule_hint"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/password"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLength="100"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:labelFor="@id/register_confirm_password"
            android:text="@string/confirm_password"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/register_confirm_password_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:endIconMode="password_toggle"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/register_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="newPassword"
                android:hint="@string/confirm_password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLength="100"
                android:saveEnabled="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/Widget.SolarGrid.Banner.Success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:text="@string/sg_register_approval_note" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_submit"
            style="@style/Widget.SolarGrid.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:text="@string/register_submit"
            app:icon="@drawable/sg_ic_arrow" />

        <LinearLayout
            android:id="@+id/register_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:indeterminateTint="@color/sg_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_8"
                android:text="@string/registering"
                android:textAppearance="@style/TextAppearance.SolarGrid.Body" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/register_back_to_login"
            style="@style/Widget.SolarGrid.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            android:text="@string/back_to_sign_in" />
    </LinearLayout>
</ScrollView>
