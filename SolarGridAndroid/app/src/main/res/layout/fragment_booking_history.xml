<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_8"
        android:paddingEnd="@dimen/sg_gutter">

        <EditText
            android:id="@+id/history_search"
            style="@style/Widget.SolarGrid.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="12dp"
            android:hint="@string/history_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="100"
            android:singleLine="true"
            app:drawableStartCompat="@drawable/sg_ic_search_field" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/history_status_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="@string/status_filter"
                android:minHeight="52dp" />

            <Spinner
                android:id="@+id/history_station_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_8"
                android:layout_weight="1"
                android:contentDescription="@string/station_filter"
                android:minHeight="52dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            android:orientation="horizontal">

            <Button
                android:id="@+id/history_from_date"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/from_date"
                android:textSize="14sp"
                app:icon="@drawable/sg_ic_calendar" />

            <Button
                android:id="@+id/history_to_date"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_8"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/to_date"
                android:textSize="14sp"
                app:icon="@drawable/sg_ic_calendar" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/history_apply_filters"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="52dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/apply_filters"
                app:icon="@drawable/sg_ic_filter" />

            <Button
                android:id="@+id/history_clear_filters"
                style="@style/Widget.SolarGrid.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_4"
                android:text="@string/clear_filters" />

            <Button
                android:id="@+id/history_refresh"
                style="@style/Widget.SolarGrid.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/refresh_history"
                android:text="@string/refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_station_notice"
            style="@style/Widget.SolarGrid.Banner.Warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            android:visibility="gone" />

        <TextView
            android:id="@+id/history_result_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label"
            android:visibility="gone" />

        <ListView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/sg_space_12"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="12dp"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="@dimen/sg_space_12"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_pagination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/sg_space_8"
            android:paddingBottom="@dimen/sg_space_16"
            android:visibility="gone">

            <Button
                android:id="@+id/history_previous"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/previous_page" />

            <TextView
                android:id="@+id/history_page_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

            <Button
                android:id="@+id/history_next"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/next_page" />
        </LinearLayout>
    </LinearLayout>

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/history_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
