<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <EditText
            android:id="@+id/history_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/history_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLength="100"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/history_status_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/status_filter" />

            <Spinner
                android:id="@+id/history_station_filter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:contentDescription="@string/station_filter" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/history_from_date"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/from_date" />

            <Button
                android:id="@+id/history_to_date"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/to_date" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/history_apply_filters"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/apply_filters" />

            <Button
                android:id="@+id/history_clear_filters"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:layout_weight="1"
                android:text="@string/clear_filters" />

            <Button
                android:id="@+id/history_refresh"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_sm"
                android:contentDescription="@string/refresh_history"
                android:text="@string/refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/history_station_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/solar_error"
            android:visibility="gone" />

        <TextView
            android:id="@+id/history_result_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <ListView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_weight="1"
            android:dividerHeight="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/history_pagination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/history_previous"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous_page" />

            <TextView
                android:id="@+id/history_page_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAlignment="center" />

            <Button
                android:id="@+id/history_next"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_page" />
        </LinearLayout>
    </LinearLayout>

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/history_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
