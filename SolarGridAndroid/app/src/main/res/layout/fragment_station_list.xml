<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_surface"
    android:orientation="vertical"
    android:padding="@dimen/space_md">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/station_list_explanation"
        android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/station_location_refresh"
        style="@style/Widget.SolarGrid.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/refresh_nearby_stations" />

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/station_list_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/station_map_unavailable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:text="@string/map_key_missing"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/station_map_container"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="@dimen/space_sm"
        android:visibility="gone" />

    <ListView
        android:id="@+id/station_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_md"
        android:layout_weight="1"
        android:dividerHeight="8dp"
        android:visibility="gone" />
</LinearLayout>
