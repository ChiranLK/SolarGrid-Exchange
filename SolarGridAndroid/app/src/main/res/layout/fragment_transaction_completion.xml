<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Transparent scroll wrapper for large fonts; the bound content view keeps its ID and toggling. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <!-- Rendered only after the server confirms the one-time completion. -->
    <LinearLayout
        android:id="@+id/transaction_completion_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_32"
        android:paddingEnd="@dimen/sg_gutter"
        android:paddingBottom="@dimen/sg_space_32"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/sg_bg_state_ring"
            android:importantForAccessibility="noHideDescendants"
            android:padding="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/sg_bg_state_tile"
                android:contentDescription="@null"
                android:padding="30dp"
                android:src="@drawable/sg_ic_check"
                app:tint="?attr/colorPrimary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:text="@string/transfer_completed_title"
            android:textAppearance="@style/TextAppearance.SolarGrid.Display" />

        <TextView
            android:id="@+id/transaction_completion_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:background="@drawable/sg_bg_card"
            android:lineSpacingExtra="6sp"
            android:padding="@dimen/sg_space_20"
            android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong"
            android:textIsSelectable="true" />

        <TextView
            style="@style/Widget.SolarGrid.Banner.Success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:text="@string/completion_server_notice" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/sg_space_24" />

        <Button
            android:id="@+id/transaction_scan_another"
            style="@style/Widget.SolarGrid.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scan_another_qr"
            app:icon="@drawable/sg_ic_qr" />

        <Button
            android:id="@+id/transaction_operator_home"
            style="@style/Widget.SolarGrid.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:text="@string/return_operator_home" />
    </LinearLayout>
    </ScrollView>

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/transaction_completion_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
