<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/reservation_detail_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <ScrollView
        android:id="@+id/reservation_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sg_gutter"
            android:paddingTop="@dimen/sg_space_8"
            android:paddingEnd="@dimen/sg_gutter"
            android:paddingBottom="@dimen/sg_space_32">

            <TextView
                android:id="@+id/reservation_detail_refresh_notice"
                style="@style/Widget.SolarGrid.Banner.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/sg_space_16"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <!-- Status + short reference -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/reservation_detail_status"
                        style="@style/Widget.SolarGrid.StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    android:id="@+id/reservation_detail_reference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sg_space_12"
                    android:contentDescription="@string/reservation_reference"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall"
                    android:textIsSelectable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/reservation_detail_station"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.SolarGrid.Display" />

            <TextView
                android:id="@+id/reservation_detail_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />

            <!-- Energy and schedule -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/sg_space_24">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/requested_energy"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sg_space_8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/reservation_detail_energy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textAppearance="@style/TextAppearance.SolarGrid.Metric" />

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/sg_ic_bolt"
                            app:tint="?attr/colorPrimary" />
                    </LinearLayout>

                    <View
                        style="@style/Widget.SolarGrid.Divider"
                        android:layout_marginTop="@dimen/sg_space_20" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sg_space_20"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/sg_ic_calendar"
                            app:tint="?attr/colorOnSurface" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/sg_space_16"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/reservation_detail_time"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/scheduled_time"
                                android:lineSpacingExtra="4sp"
                                android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Actions: primary QR, then modify (secondary) and cancel (destructive). -->
            <Button
                android:id="@+id/reservation_qr_button"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_20"
                android:text="@string/open_reservation_qr"
                android:visibility="gone"
                app:icon="@drawable/sg_ic_qr" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/reservation_update_button"
                    style="@style/Widget.SolarGrid.Button.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/modify_reservation"
                    app:icon="@drawable/sg_ic_edit" />

                <Button
                    android:id="@+id/reservation_cancel_button"
                    style="@style/Widget.SolarGrid.Button.Destructive"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sg_space_12"
                    android:layout_weight="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/cancel_reservation" />
            </LinearLayout>

            <TextView
                android:id="@+id/reservation_cancellation_progress"
                style="@style/Widget.SolarGrid.Banner.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/reservation_rejection_reason_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:background="@drawable/sg_bg_banner_error"
                android:orientation="vertical"
                android:padding="@dimen/sg_space_20"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rejection_reason"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow"
                    android:textColor="@color/sg_on_error_container" />

                <TextView
                    android:id="@+id/reservation_detail_rejection_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_8"
                    android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong"
                    android:textColor="@color/sg_on_error_container" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reservation_cancellation_reason_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:background="@drawable/sg_bg_tonal_card"
                android:orientation="vertical"
                android:padding="@dimen/sg_space_20"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancellation_reason"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

                <TextView
                    android:id="@+id/reservation_detail_cancellation_reason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_8"
                    android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong" />
            </LinearLayout>

            <!-- Booking facts -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_20">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sg_space_20"
                    android:paddingTop="@dimen/sg_space_8"
                    android:paddingEnd="@dimen/sg_space_20"
                    android:paddingBottom="@dimen/sg_space_8">

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/prosumer_label" />
                        <TextView android:id="@+id/reservation_detail_prosumer" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <View style="@style/Widget.SolarGrid.Divider" />

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/slot_reference" />
                        <TextView
                            android:id="@+id/reservation_detail_slot"
                            style="@style/Widget.SolarGrid.ReceiptValue"
                            android:fontFamily="monospace"
                            android:textIsSelectable="true"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <View style="@style/Widget.SolarGrid.Divider" />

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/created_at" />
                        <TextView android:id="@+id/reservation_detail_created" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <View style="@style/Widget.SolarGrid.Divider" />

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/updated_at" />
                        <TextView android:id="@+id/reservation_detail_updated" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Server-provided action availability and reasons -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_32"
                android:accessibilityHeading="true"
                android:text="@string/allowed_actions"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <TextView
                android:id="@+id/reservation_detail_allowed_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:background="@drawable/sg_bg_tonal_card"
                android:lineSpacingExtra="4sp"
                android:padding="@dimen/sg_space_20"
                android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

            <!-- Status history -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_32"
                android:accessibilityHeading="true"
                android:text="@string/status_history"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <TextView
                android:id="@+id/reservation_detail_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:background="@drawable/sg_bg_card"
                android:lineSpacingExtra="4sp"
                android:padding="@dimen/sg_space_20"
                android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
