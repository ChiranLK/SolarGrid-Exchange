<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <Spinner
            android:id="@+id/reservation_view_filter"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/reservation_filter" />

        <TextView
            android:id="@+id/reservation_list_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reservation_refresh_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textColor="@android:color/holo_red_dark"
            android:visibility="gone" />

        <ListView
            android:id="@+id/reservation_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:dividerHeight="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/reservation_list_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
