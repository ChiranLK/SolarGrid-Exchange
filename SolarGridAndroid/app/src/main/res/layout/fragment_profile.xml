<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_8"
        android:paddingEnd="@dimen/sg_gutter"
        android:paddingBottom="@dimen/sg_space_32">

        <com.solargrid.exchange.ui.common.UiStateView
            android:id="@+id/profile_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Staff (Grid Operator) read-only profile -->
        <LinearLayout
            android:id="@+id/profile_staff_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_staff_initials"
                    style="@style/Widget.SolarGrid.ProfileAvatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sg_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Headline" />

                    <TextView
                        android:id="@+id/profile_staff_role_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Body" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sg_space_20"
                    android:paddingTop="@dimen/sg_space_12"
                    android:paddingEnd="@dimen/sg_space_20"
                    android:paddingBottom="@dimen/sg_space_12">

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/sg_profile_name" />
                        <TextView android:id="@+id/profile_staff_name_row" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/nic_label" />
                        <TextView android:id="@+id/profile_nic" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/email_label" />
                        <TextView android:id="@+id/profile_email" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/role_label" />
                        <TextView android:id="@+id/profile_role" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/status_label" />
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/profile_status"
                                style="@style/Widget.SolarGrid.StatusPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.SolarGrid.Banner.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:text="@string/sg_profile_staff_note" />
        </LinearLayout>

        <!-- Prosumer profile -->
        <LinearLayout
            android:id="@+id/profile_prosumer_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profile_prosumer_initials"
                    style="@style/Widget.SolarGrid.ProfileAvatar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sg_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profile_prosumer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Headline" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sg_profile_prosumer_account"
                        android:textAppearance="@style/TextAppearance.SolarGrid.Body" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/profile_message"
                style="@style/Widget.SolarGrid.Banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/sg_space_20"
                    android:paddingTop="@dimen/sg_space_20"
                    android:paddingEnd="@dimen/sg_space_20"
                    android:paddingBottom="@dimen/sg_space_20">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:text="@string/sg_profile_identity"
                            android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:src="@drawable/sg_ic_lock"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/nic_label" />
                        <TextView android:id="@+id/profile_prosumer_nic" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/status_label" />
                        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/profile_prosumer_status"
                                style="@style/Widget.SolarGrid.StatusPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                        <TextView style="@style/Widget.SolarGrid.ReceiptLabel" android:text="@string/sg_profile_deactivation" />
                        <TextView android:id="@+id/profile_deactivation_state" style="@style/Widget.SolarGrid.ReceiptValue" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sg_space_4"
                        android:text="@string/sg_profile_identity_note"
                        android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_32"
                android:accessibilityHeading="true"
                android:text="@string/sg_profile_personal"
                android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:labelFor="@id/profile_full_name"
                android:text="@string/full_name"
                android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_full_name_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/sg_ic_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_full_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:hint="@string/full_name"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:labelFor="@id/profile_edit_email"
                android:text="@string/email_address"
                android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_edit_email_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/sg_ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_edit_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="@string/email_address"
                    android:inputType="textEmailAddress"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:labelFor="@id/profile_phone"
                android:text="@string/phone"
                android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_phone_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/sg_ic_phone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:hint="@string/phone"
                    android:inputType="phone"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:labelFor="@id/profile_address"
                android:text="@string/address_optional"
                android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/profile_address_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_8"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/sg_ic_pin">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/profile_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:hint="@string/address_optional"
                    android:inputType="textPostalAddress|textMultiLine"
                    android:maxLength="200" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profile_save"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24"
                android:text="@string/profile_save" />

            <!-- Danger zone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24"
                android:background="@drawable/sg_bg_danger_card"
                android:orientation="vertical"
                android:padding="@dimen/sg_space_20">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/close_account_title"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Title"
                    android:textColor="@color/sg_error" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_12"
                    android:text="@string/sg_profile_close_body"
                    android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_request_deactivation"
                    style="@style/Widget.SolarGrid.Button.Destructive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_20"
                    android:text="@string/request_deactivation" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
