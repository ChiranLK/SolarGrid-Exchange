<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/sg_space_32">

    <FrameLayout
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/sg_bg_state_ring"
        android:importantForAccessibility="noHideDescendants"
        android:padding="8dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/sg_bg_state_tile"
            android:contentDescription="@null"
            android:padding="30dp"
            android:src="@drawable/sg_ic_grid"
            app:tint="@color/sg_primary" />
    </FrameLayout>

    <TextView
        android:id="@+id/placeholder_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_24"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SolarGrid.Headline" />

    <TextView
        android:id="@+id/placeholder_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sg_space_12"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SolarGrid.Body" />
</LinearLayout>
