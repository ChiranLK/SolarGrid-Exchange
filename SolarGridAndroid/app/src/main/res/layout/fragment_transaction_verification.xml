<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/transaction_verification_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/sg_gutter"
            android:paddingTop="@dimen/sg_space_16"
            android:paddingEnd="@dimen/sg_gutter"
            android:paddingBottom="@dimen/sg_space_32">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/sg_bg_state_ring"
                android:importantForAccessibility="noHideDescendants"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/sg_bg_state_tile"
                    android:contentDescription="@null"
                    android:padding="30dp"
                    android:src="@drawable/sg_ic_shield"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:text="@string/verification_confirmed_title"
                android:textAppearance="@style/TextAppearance.SolarGrid.Headline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/verification_status"
                        style="@style/Widget.SolarGrid.StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>

                <TextView
                    android:id="@+id/verification_expiry"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sg_space_12"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="viewEnd"
                    android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />
            </LinearLayout>

            <!-- Server-provided transfer details (one multi-line field from the fragment). -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/sg_space_20">

                    <TextView
                        android:id="@+id/verification_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:lineSpacingExtra="6sp"
                        android:textAppearance="@style/TextAppearance.SolarGrid.BodyStrong"
                        android:textIsSelectable="true" />

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/sg_space_12"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/sg_ic_bolt"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Irreversible-action warning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:background="@drawable/sg_bg_banner_warning"
                android:orientation="vertical"
                android:padding="@dimen/sg_space_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="10dp"
                    android:gravity="center_vertical"
                    android:text="@string/sg_verify_care_title"
                    android:textColor="@color/sg_on_pending_container"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/sg_ic_banner_warning" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_8"
                    android:text="@string/completion_authority_notice"
                    android:textColor="@color/sg_on_pending_container"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/verification_completion_progress"
                style="@style/Widget.SolarGrid.Banner.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:accessibilityLiveRegion="polite"
                android:text="@string/completing_transfer"
                android:visibility="gone" />

            <TextView
                android:id="@+id/verification_completion_error"
                style="@style/Widget.SolarGrid.Banner.Error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_16"
                android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />

            <Button
                android:id="@+id/verification_complete"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_24"
                android:text="@string/confirm_transfer_completion"
                app:icon="@drawable/sg_ic_check" />

            <Button
                android:id="@+id/verification_retry_completion"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:text="@string/retry_completion"
                android:visibility="gone"
                app:icon="@drawable/sg_ic_refresh" />

            <Button
                android:id="@+id/verification_scan_again"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/sg_space_12"
                android:text="@string/scan_another_qr" />
        </LinearLayout>
    </ScrollView>

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/transaction_verification_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
