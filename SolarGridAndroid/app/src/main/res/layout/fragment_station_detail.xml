<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/solar_surface">

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/station_detail_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/station_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_lg"
        android:visibility="gone">

        <TextView
            android:id="@+id/station_detail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SolarGrid.Headline" />

        <TextView
            android:id="@+id/station_detail_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

        <TextView
            android:id="@+id/station_detail_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" />

        <TextView
            android:id="@+id/station_detail_capacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/station_slot_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:textAppearance="@style/TextAppearance.SolarGrid.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:text="@string/availability_not_cached"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

        <ListView
            android:id="@+id/station_slot_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_md"
            android:layout_weight="1"
            android:dividerHeight="8dp" />
    </LinearLayout>
</FrameLayout>
