<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingStart="@dimen/sg_gutter"
    android:paddingTop="@dimen/sg_space_8"
    android:paddingEnd="@dimen/sg_gutter">

    <TextView
        style="@style/Widget.SolarGrid.Banner.Info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/availability_not_cached"
        android:textSize="14sp" />

    <com.solargrid.exchange.ui.common.UiStateView
        android:id="@+id/available_slot_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ListView
        android:id="@+id/available_slot_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/sg_space_12"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@android:color/transparent"
        android:dividerHeight="12dp"
        android:listSelector="@android:color/transparent"
        android:paddingBottom="@dimen/sg_space_12"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/available_slot_pagination"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/sg_space_8"
        android:paddingBottom="@dimen/sg_space_16"
        android:visibility="gone">

        <Button
            android:id="@+id/available_slot_previous"
            style="@style/Widget.SolarGrid.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/previous_page" />

        <TextView
            android:id="@+id/available_slot_page_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <Button
            android:id="@+id/available_slot_next"
            style="@style/Widget.SolarGrid.Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/next_page" />
    </LinearLayout>
</LinearLayout>
