<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_8"
        android:paddingEnd="@dimen/sg_gutter"
        android:paddingBottom="@dimen/sg_space_32">

        <include layout="@layout/sg_stepper_2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityHeading="true"
            android:text="@string/sg_review_hero"
            android:textAppearance="@style/TextAppearance.SolarGrid.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            android:text="@string/sg_review_subtitle"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_4"
            android:text="@string/seven_day_booking_guidance"
            android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />

        <!-- Persistent server error (booking conflicts, capacity changes). Shown by BookingReviewFragment. -->
        <TextView
            android:id="@+id/booking_review_error"
            style="@style/Widget.SolarGrid.Banner.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_20"
            android:accessibilityLiveRegion="assertive"
            android:visibility="gone" />

        <!-- Receipt -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/sg_space_20"
                android:paddingTop="@dimen/sg_space_8"
                android:paddingEnd="@dimen/sg_space_20"
                android:paddingBottom="@dimen/sg_space_20">

                <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                    <TextView
                        style="@style/Widget.SolarGrid.ReceiptLabel"
                        android:text="@string/station_label" />
                    <TextView
                        android:id="@+id/booking_review_station"
                        style="@style/Widget.SolarGrid.ReceiptValue" />
                </LinearLayout>

                <View style="@style/Widget.SolarGrid.Divider" />

                <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                    <TextView
                        style="@style/Widget.SolarGrid.ReceiptLabel"
                        android:text="@string/booking_date" />
                    <TextView
                        android:id="@+id/booking_review_date"
                        style="@style/Widget.SolarGrid.ReceiptValue" />
                </LinearLayout>

                <View style="@style/Widget.SolarGrid.Divider" />

                <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                    <TextView
                        style="@style/Widget.SolarGrid.ReceiptLabel"
                        android:text="@string/booking_time" />
                    <TextView
                        android:id="@+id/booking_review_time"
                        style="@style/Widget.SolarGrid.ReceiptValue" />
                </LinearLayout>

                <View style="@style/Widget.SolarGrid.Divider" />

                <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                    <TextView
                        style="@style/Widget.SolarGrid.ReceiptLabel"
                        android:text="@string/prosumer_label" />
                    <TextView
                        android:id="@+id/booking_review_prosumer"
                        style="@style/Widget.SolarGrid.ReceiptValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sg_space_20"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/requested_energy"
                            android:textAppearance="@style/TextAppearance.SolarGrid.Eyebrow" />

                        <TextView
                            android:id="@+id/booking_review_quantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sg_space_4"
                            android:textAppearance="@style/TextAppearance.SolarGrid.Metric" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="@dimen/sg_space_8"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/sg_ic_bolt"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Secondary facts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:background="@drawable/sg_bg_tonal_card"
            android:orientation="vertical"
            android:paddingStart="@dimen/sg_space_20"
            android:paddingTop="@dimen/sg_space_8"
            android:paddingEnd="@dimen/sg_space_20"
            android:paddingBottom="@dimen/sg_space_8">

            <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                <TextView
                    style="@style/Widget.SolarGrid.ReceiptLabel"
                    android:text="@string/slot_reference" />
                <TextView
                    android:id="@+id/booking_review_slot"
                    style="@style/Widget.SolarGrid.ReceiptValue"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                <TextView
                    style="@style/Widget.SolarGrid.ReceiptLabel"
                    android:text="@string/available_capacity_at_selection" />
                <TextView
                    android:id="@+id/booking_review_capacity"
                    style="@style/Widget.SolarGrid.ReceiptValue" />
            </LinearLayout>

            <LinearLayout style="@style/Widget.SolarGrid.ReceiptRow">
                <TextView
                    style="@style/Widget.SolarGrid.ReceiptLabel"
                    android:text="@string/initial_expected_status" />
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/booking_review_status"
                        style="@style/Widget.SolarGrid.StatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Widget.SolarGrid.Banner.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:text="@string/review_authority_notice" />

        <TextView
            android:id="@+id/booking_review_progress"
            style="@style/Widget.SolarGrid.Banner.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:accessibilityLiveRegion="polite"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:orientation="horizontal">

            <Button
                android:id="@+id/booking_review_edit_button"
                style="@style/Widget.SolarGrid.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/edit_selection" />

            <Button
                android:id="@+id/booking_review_confirm_button"
                style="@style/Widget.SolarGrid.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sg_space_12"
                android:layout_weight="1.4"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/confirm_booking" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
