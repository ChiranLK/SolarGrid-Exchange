<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/sg_gutter"
        android:paddingTop="@dimen/sg_space_32"
        android:paddingEnd="@dimen/sg_gutter"
        android:paddingBottom="@dimen/sg_space_32">

        <include layout="@layout/sg_brand_row" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_32"
            android:accessibilityHeading="true"
            android:text="@string/sg_login_hero"
            android:textAppearance="@style/TextAppearance.SolarGrid.Display" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:text="@string/sg_login_intro"
            android:textAppearance="@style/TextAppearance.SolarGrid.Body" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:adjustViewBounds="true"
            android:background="@drawable/sg_bg_illustration"
            android:clipToOutline="true"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/sg_illustration_solar" />

        <TextView
            android:id="@+id/login_notice"
            style="@style/Widget.SolarGrid.Banner.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityLiveRegion="polite"
            android:visibility="gone" />

        <TextView
            android:id="@+id/login_error"
            style="@style/Widget.SolarGrid.Banner.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:accessibilityLiveRegion="assertive"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:labelFor="@id/login_email"
            android:text="@string/email_address"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_mail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="emailAddress"
                android:hint="@string/sg_email_placeholder"
                android:imeOptions="actionNext"
                android:inputType="textEmailAddress"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_16"
            android:labelFor="@id/login_password"
            android:text="@string/password"
            android:textAppearance="@style/TextAppearance.SolarGrid.Label" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_8"
            app:endIconMode="password_toggle"
            app:hintEnabled="false"
            app:startIconDrawable="@drawable/sg_ic_lock">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/login_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="password"
                android:hint="@string/password"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:minHeight="56dp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_submit"
            style="@style/Widget.SolarGrid.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_24"
            android:text="@string/sign_in"
            app:icon="@drawable/sg_ic_arrow" />

        <ProgressBar
            android:id="@+id/login_progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sg_space_16"
            android:indeterminateTint="@color/sg_primary"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sg_space_24"
            android:text="@string/login_register_prompt"
            android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/login_register"
            style="@style/Widget.SolarGrid.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sg_space_12"
            android:text="@string/create_prosumer_account" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/sg_space_24"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="@string/sg_login_secure"
            android:textAppearance="@style/TextAppearance.SolarGrid.BodySmall"
            app:drawableStartCompat="@drawable/sg_ic_shield" />
    </LinearLayout>
</ScrollView>
