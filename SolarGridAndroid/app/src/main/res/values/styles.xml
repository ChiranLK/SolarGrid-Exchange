<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography. Existing names (Headline, Title, Body) are kept and restyled. -->
    <style name="TextAppearance.SolarGrid.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:lineSpacingMultiplier">1.08</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.Headline" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.005</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.SolarGrid.BodyStrong" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.SolarGrid.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.SolarGrid.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.SolarGrid.Metric" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">40sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.SolarGrid.Hero" parent="TextAppearance.SolarGrid.Headline">
        <item name="android:textColor">@color/sg_on_hero</item>
    </style>

    <style name="TextAppearance.SolarGrid.HeroBody" parent="TextAppearance.SolarGrid.Body">
        <item name="android:textColor">@color/sg_on_hero_muted</item>
    </style>

    <style name="TextAppearance.SolarGrid.HeroEyebrow" parent="TextAppearance.SolarGrid.Eyebrow">
        <item name="android:textColor">@color/sg_on_hero_muted</item>
    </style>

    <style name="TextAppearance.SolarGrid.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- Buttons. Widget.SolarGrid.Button stays the primary action used across layouts. -->
    <style name="Widget.SolarGrid.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/sg_button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Button</item>
        <item name="backgroundTint">@color/sg_primary_button_background</item>
        <item name="android:textColor">@color/sg_primary_button_text</item>
        <item name="iconTint">@color/sg_primary_button_text</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.SolarGrid.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/sg_button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Button</item>
        <item name="android:textColor">@color/sg_secondary_button_text</item>
        <item name="iconTint">@color/sg_secondary_button_text</item>
        <item name="strokeColor">@color/sg_secondary_button_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.SolarGrid.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/sg_button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Button</item>
        <item name="backgroundTint">@color/sg_tonal_button_background</item>
        <item name="android:textColor">@color/sg_secondary_button_text</item>
        <item name="iconTint">@color/sg_secondary_button_text</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.SolarGrid.Button.Destructive" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/sg_button_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Button</item>
        <item name="android:textColor">@color/sg_destructive_button_text</item>
        <item name="iconTint">@color/sg_destructive_button_text</item>
        <item name="strokeColor">@color/sg_destructive_button_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.SolarGrid.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/sg_touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Button</item>
        <item name="android:textColor">@color/sg_secondary_button_text</item>
        <item name="iconTint">@color/sg_secondary_button_text</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Shapes, cards and fields. -->
    <style name="ShapeAppearanceOverlay.SolarGrid.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/sg_radius_card</item>
    </style>

    <style name="ShapeAppearanceOverlay.SolarGrid.Field" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/sg_radius_field</item>
    </style>

    <style name="ShapeAppearanceOverlay.SolarGrid.NavItem" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.SolarGrid.Drawer" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomRight">28dp</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="Widget.SolarGrid.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SolarGrid.Card</item>
        <item name="cardBackgroundColor">@color/sg_card_surface</item>
        <item name="strokeColor">@color/sg_outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.SolarGrid.Card.Tonal" parent="Widget.SolarGrid.Card">
        <item name="cardBackgroundColor">@color/sg_surface_container</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.SolarGrid.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SolarGrid.Field</item>
        <item name="boxBackgroundColor">@color/sg_card_surface</item>
        <item name="boxStrokeColor">@color/sg_field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/sg_primary</item>
        <item name="startIconTint">@color/sg_on_surface_variant</item>
        <item name="endIconTint">@color/sg_on_surface_variant</item>
        <item name="boxStrokeErrorColor">@color/sg_error</item>
        <item name="errorTextColor">@color/sg_error</item>
        <item name="errorIconTint">@color/sg_error</item>
        <item name="helperTextTextColor">@color/sg_on_surface_variant</item>
    </style>

    <!-- Plain EditText inside a dialog or a legacy binding that must stay an EditText. -->
    <style name="Widget.SolarGrid.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/sg_bg_field</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.SolarGrid.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/sg_bg_spinner</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">44dp</item>
        <item name="android:popupBackground">@drawable/sg_bg_popup</item>
    </style>

    <!-- Banners: decoration sits on the toggled TextView itself, so GONE leaves nothing behind. -->
    <style name="Widget.SolarGrid.Banner" parent="">
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>

    <style name="Widget.SolarGrid.Banner.Error">
        <item name="android:background">@drawable/sg_bg_banner_error</item>
        <item name="android:textColor">@color/sg_on_error_container</item>
        <item name="android:drawableStart">@drawable/sg_ic_banner_alert</item>
    </style>

    <style name="Widget.SolarGrid.Banner.Info">
        <item name="android:background">@drawable/sg_bg_banner_info</item>
        <item name="android:textColor">@color/sg_on_surface_variant</item>
        <item name="android:drawableStart">@drawable/sg_ic_banner_info</item>
    </style>

    <style name="Widget.SolarGrid.Banner.Success">
        <item name="android:background">@drawable/sg_bg_banner_success</item>
        <item name="android:textColor">@color/sg_on_approved_container</item>
        <item name="android:drawableStart">@drawable/sg_ic_banner_success</item>
    </style>

    <style name="Widget.SolarGrid.Banner.Warning">
        <item name="android:background">@drawable/sg_bg_banner_warning</item>
        <item name="android:textColor">@color/sg_on_pending_container</item>
        <item name="android:drawableStart">@drawable/sg_ic_banner_warning</item>
    </style>

    <!-- Neutral status pill. StatusStyles applies the semantic colour from the real status value. -->
    <style name="Widget.SolarGrid.StatusPill" parent="">
        <item name="android:background">@drawable/sg_bg_status_neutral</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:drawableStart">@drawable/sg_status_dot</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/sg_on_cancelled_container</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/sg_on_cancelled_container</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SolarGrid.IconTile" parent="">
        <item name="android:layout_width">52dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/sg_bg_icon_tile</item>
        <item name="android:padding">14dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="tint">@color/sg_primary</item>
    </style>

    <style name="Widget.SolarGrid.Divider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/sg_outline_variant</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Toolbar and drawer. -->
    <style name="Widget.SolarGrid.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">@color/sg_background</item>
        <item name="titleTextAppearance">@style/TextAppearance.SolarGrid.ToolbarTitle</item>
        <item name="titleTextColor">@color/sg_on_surface</item>
        <item name="navigationIconTint">@color/sg_on_surface</item>
    </style>

    <style name="TextAppearance.SolarGrid.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SolarGrid.NavItem" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.SolarGrid.NavSubheader" parent="TextAppearance.SolarGrid.Eyebrow" />

    <style name="Widget.SolarGrid.NavigationView" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/sg_card_surface</item>
        <item name="itemShapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SolarGrid.NavItem</item>
        <item name="itemShapeFillColor">@color/sg_nav_item_background</item>
        <item name="itemShapeInsetStart">12dp</item>
        <item name="itemShapeInsetEnd">12dp</item>
        <item name="itemShapeInsetTop">4dp</item>
        <item name="itemShapeInsetBottom">4dp</item>
        <item name="itemIconTint">@color/sg_nav_item_content</item>
        <item name="itemTextColor">@color/sg_nav_item_content</item>
        <item name="itemTextAppearanceActiveBoldEnabled">true</item>
        <item name="itemTextAppearance">@style/TextAppearance.SolarGrid.NavItem</item>
        <item name="subheaderTextAppearance">@style/TextAppearance.SolarGrid.NavSubheader</item>
        <item name="subheaderColor">@color/sg_on_surface_variant</item>
        <item name="itemHorizontalPadding">20dp</item>
        <item name="itemIconPadding">20dp</item>
        <item name="itemVerticalPadding">14dp</item>
        <item name="drawerLayoutCornerSize">28dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SolarGrid.Drawer</item>
        <item name="dividerInsetStart">24dp</item>
        <item name="dividerInsetEnd">24dp</item>
    </style>

    <style name="ThemeOverlay.SolarGrid.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.SolarGrid.Card</item>
        <item name="colorSurface">@color/sg_card_surface</item>
        <item name="colorSurfaceContainerHigh">@color/sg_card_surface</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
    </style>

    <!-- Empty section message: decoration on the toggled TextView itself. -->
    <style name="Widget.SolarGrid.EmptyCard" parent="">
        <item name="android:background">@drawable/sg_bg_card</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:paddingTop">28dp</item>
        <item name="android:paddingBottom">28dp</item>
        <item name="android:drawableTop">@drawable/sg_ic_sun_empty</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.Body</item>
    </style>

    <!-- Receipt rows: label on the start side, value on the end side, both wrap for large fonts. -->
    <style name="Widget.SolarGrid.ReceiptRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="Widget.SolarGrid.ReceiptLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.BodySmall</item>
    </style>

    <style name="Widget.SolarGrid.ReceiptValue" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1.3</item>
        <item name="android:gravity">end</item>
        <item name="android:textAlignment">viewEnd</item>
        <item name="android:textAppearance">@style/TextAppearance.SolarGrid.BodyStrong</item>
    </style>

    <!-- AppCompat AlertDialog hosts (e.g. cancel reservation) rendered with Material 3 shape and type. -->
    <style name="ThemeOverlay.SolarGrid.AppCompatDialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="dialogCornerRadius">28dp</item>
        <item name="colorSurface">@color/sg_card_surface</item>
        <item name="android:windowBackground">@drawable/sg_bg_dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.SolarGrid.Button.Text</item>
    </style>

    <!-- Onboarding -->
    <style name="Widget.SolarGrid.OnboardingChip" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/sg_bg_onboarding_chip</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/sg_on_hero</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SolarGrid.OnboardingPoint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawableStart">@drawable/sg_ic_check_gold</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:textColor">@color/sg_on_hero</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Role-based bottom navigation -->
    <style name="Widget.SolarGrid.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/sg_bg_bottom_nav</item>
        <item name="itemIconTint">@color/sg_bottom_nav_icon</item>
        <item name="itemTextColor">@color/sg_bottom_nav_text</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SolarGrid.BottomNav.Indicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SolarGrid.BottomNavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SolarGrid.BottomNavLabel</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.SolarGrid.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/sg_primary_container</item>
    </style>

    <style name="TextAppearance.SolarGrid.BottomNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.SolarGrid.BottomNavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.SolarGrid.ProfileAvatar" parent="">
        <item name="android:layout_width">80dp</item>
        <item name="android:layout_height">80dp</item>
        <item name="android:background">@drawable/sg_bg_avatar</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:textColor">@color/sg_on_primary_container</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>