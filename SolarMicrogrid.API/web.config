<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS web.config
  Purpose : Hosts the framework-dependent .NET 10 API in-process through the
            ASP.NET Core Module. Secrets must be configured outside this file.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore"
             path="*"
             verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\SolarMicrogrid.API.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
