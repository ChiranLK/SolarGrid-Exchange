{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MongoDbSettings":{
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "SolarMicrogrid",
    "UsersCollectionName": "Users",
    "SolarStationInfoCollectionName": "SolarStationInfo",
    "EnergyBookingSlotsCollectionName": "EnergyBookingSlots",
    "EnergyReservationsCollectionName": "EnergyReservations"
  },

  "JwtSettings":{
    "Key": "your_secret_key_here",
    "Issuer": "SolarGridApi",
    "Audience": "SolarGridClients",
    "ExpiryMinutes": 60
  },

  "BusinessRules":{
    "MaxBookingDaysAhead": 7,
    "MinChangeNoticeHours": 12
  }
}
