{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoSettings": {
    "ConnectionString": "",
    "DatabaseName": "SolarGridExchangeDb",
    "UsersCollectionName": "Users",
    "StationsCollectionName": "SolarStationInfo",
    "SlotsCollectionName": "EnergyBookingSlots",
